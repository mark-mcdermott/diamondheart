{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Diamondheart",
  "version": "0.1.0",
  "identifier": "app.diamondheart.desktop",
  "build": {
    "frontendDist": "https://diamondheart.app",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Diamondheart",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
