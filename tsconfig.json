{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*", "e2e/**/*", "native/**/*", "playwright.config.ts", "vite.native.config.ts", "vitest.config.ts", "vitest.api.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", ".vercel", "src-tauri", "android", "ios"]
}
