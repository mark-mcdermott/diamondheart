---
import Public from "@/layouts/Public.astro";
import { Check } from "lucide-react";
---

<Public title="Order confirmed — Diamondheart">
  <div class="max-w-2xl mx-auto px-4 py-16 text-center">
    <div class="w-16 h-16 rounded-full bg-success/10 flex items-center justify-center mx-auto mb-6">
      <Check className="w-8 h-8 text-success" />
    </div>
    <h1>Order Confirmed</h1>
    <p class="text-muted-foreground mt-4 mb-8">
      Thanks for your purchase! You'll receive a confirmation email shortly. Your order will be printed and shipped by our
      fulfillment partner.
    </p>
    <div class="flex gap-3 justify-center">
      <a href="/merch" class="inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">Continue Shopping</a>
      <a href="/dashboard" class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted">Dashboard</a>
    </div>
  </div>
</Public>
