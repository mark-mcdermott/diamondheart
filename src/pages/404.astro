---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found — Diamondheart">
  <div class="flex min-h-screen items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-foreground">404</h1>
      <p class="mt-4 text-lg text-muted-foreground">Page not found</p>
      <a href="/" class="mt-6 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90">
        Go home
      </a>
    </div>
  </div>
</Base>
