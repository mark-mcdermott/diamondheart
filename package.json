{
  "name": "diamondheart",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:api": "node --env-file-if-exists=.env --import tsx scripts/e2e-db.ts -- pnpm exec vitest run --config vitest.api.config.ts",
    "test:e2e": "E2E_DB_READY=1 node --env-file-if-exists=.env --import tsx scripts/e2e-db.ts -- pnpm exec playwright test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "db:seed:feed": "node --env-file=.env --import tsx scripts/seed-community-feed.ts",
    "db:migrate:tracker-scope": "node --env-file=.env --import tsx scripts/migrate-tracker-user-scope.ts",
    "db:migrate:better-auth": "node --env-file=.env --import tsx scripts/migrate-better-auth.ts",
    "db:reseed:tracker": "node --env-file=.env --import tsx scripts/reseed-tracker.ts",
    "db:nav-defaults": "node --env-file=.env --import tsx scripts/apply-nav-defaults.ts",
    "db:seed:feed:clean": "node --env-file=.env --import tsx scripts/seed-community-feed.ts clean",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "cap": "cap",
    "cap:sync": "pnpm build:native && cap sync && tsx scripts/patch-android-splash.ts && tsx scripts/patch-ios-info.ts && tsx scripts/patch-ios-capabilities.ts",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "preview": "astro preview",
    "astro": "astro",
    "build:native": "vite build --config vite.native.config.ts --mode native"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@astrojs/react": "^6.0.6",
    "@astrojs/vercel": "^11.0.11",
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.3.5",
