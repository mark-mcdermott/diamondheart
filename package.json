    "globals": "^15.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "next": "-",
      "js-yaml": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "@humanfs/node": "^0.16.8",
      "uuid@7": "^11.1.1",
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "effect": "3.20.0"
    }
  }
}
