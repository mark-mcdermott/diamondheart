    "@capgo/capacitor-health": "8.11.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nanostores/react": "^2.0.1",
    "@neondatabase/serverless": "^1.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@uploadthing/react": "^7.3.3",
    "astro": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.400.0",
    "nanostores": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.8",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.17",
    "uploadthing": "^7.7.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
