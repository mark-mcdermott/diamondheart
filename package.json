{
	"name": "ortholinear",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:auth": "vitest run src/lib/__tests__/password.test.ts src/lib/__tests__/login.test.ts src/lib/__tests__/account.test.ts",
		"test:api": "vitest run src/lib/__tests__/stripe-webhook.test.ts src/lib/__tests__/printful-webhook.test.ts src/lib/__tests__/food-search.test.ts src/lib/__tests__/backup.test.ts",
		"test:actions": "vitest run src/lib/__tests__/food-actions.test.ts src/lib/__tests__/metrics-actions.test.ts src/lib/__tests__/workout-actions.test.ts src/lib/__tests__/contact.test.ts",
		"test:unit": "vitest run src/lib/__tests__/utils.test.ts src/lib/__tests__/merch.test.ts src/lib/__tests__/printful.test.ts",
		"test:biometric": "vitest run src/lib/__tests__/biometrics.test.ts src/lib/__tests__/oura-sync.test.ts src/lib/__tests__/oura-oauth.test.ts src/lib/__tests__/healthkit-sync.test.ts src/lib/__tests__/integrations.test.ts",
		"test:regression": "npm run test:auth && npm run test:api && npm run test:actions && npm run test:unit && npm run test:biometric",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push --force",
		"db:studio": "drizzle-kit studio",
		"db:seed-office": "npx tsx scripts/seed-office.ts",
		"db:seed-exercises": "npx tsx scripts/seed-exercises.ts",
		"db:seed-custom-foods": "npx tsx scripts/seed-custom-foods.ts",
		"db:restore": "npx tsx scripts/restore-db.ts",
		"ios:build": "CAPACITOR=1 vite build && npx cap sync ios",
		"ios:dev": "npx cap open ios",
		"ios:sync": "CAPACITOR=1 vite build && npx cap sync ios",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@capacitor/core": "^8.0.0",
		"@capacitor/ios": "^8.0.0",
		"@capgo/capacitor-health": "^8.4.1",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@neondatabase/serverless": "^0.10.4",
		"@tauri-apps/api": "^2.10.1",
		"bits-ui": "^2.14.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.38.3",
		"lucia": "^3.2.2",
		"lucide-svelte": "^0.468.0",
		"stripe": "^17.4.0",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^3.0.2"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^4.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@tauri-apps/cli": "^2.10.1",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.30.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	}
}