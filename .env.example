# Database (Neon PostgreSQL)
DATABASE_URL=

# Auth (JWT signing secret - generate with: openssl rand -base64 32)
AUTH_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printful
PRINTFUL_API_KEY=

# USDA Food Database
USDA_API_KEY=

# OMDb API (movie/TV poster lookups — https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# Oura Ring
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Cloudflare R2 (backups)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=

# Backup trigger
BACKUP_SECRET=

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E tests — scripts/e2e-db.ts creates a disposable Neon branch per run.
# NEON_PROJECT_ID is only needed if the API key can see more than one project.
NEON_API_KEY=
NEON_PROJECT_ID=
# Set this to run E2E against a specific database instead, skipping Neon entirely.
TEST_DATABASE_URL=
